<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only, into a folder of their own: a benchmark must measure the
     published packages, never a locally built copy that happens to have the same version. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
